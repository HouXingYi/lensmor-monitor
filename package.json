{
  "name": "lensmor-monitor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --parallel --filter @lensmor/web --filter @lensmor/worker dev",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:generate": "pnpm --filter @lensmor/db db:generate",
    "db:migrate": "pnpm --filter @lensmor/db db:migrate",
    "test:e2e": "vitest run apps/web/e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
